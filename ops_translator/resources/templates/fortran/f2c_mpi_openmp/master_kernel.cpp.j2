{% extends "fortran/master_kernel.cpp.j2" %}

{% block ops_headers %}
{{super()}}

{% if user_types %}
#include "user_types.h"
{% endif %}
{% endblock %}

{% block const_decls %}
//  global constants
    {% for const in app.consts() %}
    {% if const.dim.isdigit() %}
        {% set NDIM = const.dim|int %}
            {% if NDIM > 1 %}
{{const_c_type[loop.index0]}} {{const.ptr}}[{{NDIM}}];
            {% else %}
{{const_c_type[loop.index0]}} {{const.ptr}};
            {% endif %}
    {% else %}
{{const_c_type[loop.index0]}} *{{const.ptr}};
    {% endif %}
    {% endfor %}

{% if jit %}
extern "C" void ops_jit_init(void);
void ops_init_backend(){ ops_jit_init(); }
{% else %}
void ops_init_backend(){}
{% endif %}

{% if jit %}
#include <cctype>
#include <cstring>

// The JIT reads constants from OPS's registry, under their Fortran (lower case) names.
static void ops_jit_register_const_f2c(char const *name, int dim, char const *type, int size, char *dat) {
    char lname[256];
    size_t n = strlen(name) < sizeof(lname) - 1 ? strlen(name) : sizeof(lname) - 1;
    for (size_t i = 0; i < n; i++) lname[i] = (char)tolower((unsigned char)name[i]);
    lname[n] = '\0';
    ops_register_const_char(OPS_instance::getOPSInstance(), dim, type, size, dat, lname);
}

{% endif %}
extern "C"
void ops_decl_const_f2c(char const *name, int dim, int size, char *dat) {
    
    ops_execute(OPS_instance::getOPSInstance());

    {% for const in app.consts() %}
    if(!strcmp(name, "{{const.name}}")) {
{% if jit %}
        ops_jit_register_const_f2c(name, dim, "{{const_c_type[loop.index0]}}", size, dat);
{% endif %}
        {% if const.dim.isdigit() %}
            {% set NDIM = const.dim|int %}
                {% if NDIM > 1 %}
        {{const_c_type[loop.index0]}} *ptr = ({{const_c_type[loop.index0]}} *)dat;
        for(int i = 0; i < NDIM; i++)
            {{const.ptr}}[i] = *ptr[i];
                {% else %}
        {{const.ptr}} = *({{const_c_type[loop.index0]}} *)dat;
                {% endif %}
        {% else %}
        {{const_c_type[loop.index0]}} *ptr = ({{const_c_type[loop.index0]}} *)dat;
        for(int i = 0; i < {{const.dim}}; i++)
            {{const.ptr}}[i] = *ptr[i];
        {% endif %}
    }
    else
    {% if loop.last %}
    {
        throw OPSException(OPS_RUNTIME_ERROR, "error: unknown const name");
    }
    {% endif %}
    {% endfor %}
}
{% endblock %}

{% block header_includes %}
{{super()}}
{% endblock %}
