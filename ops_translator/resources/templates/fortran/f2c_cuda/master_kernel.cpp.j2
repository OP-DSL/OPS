{% extends "fortran/master_kernel.cpp.j2" %}

{% block ops_headers %}
{{super()}}
{% if target.name == "f2c_cuda" %}
#include "ops_cuda_rt_support.h"
#include "ops_cuda_reduction.h"

#include <cuComplex.h>
{% elif target.name == "f2c_hip" %}
#include "ops_hip_rt_support.h"
#include "ops_hip_reduction.h"
{% endif %}

{% if user_types %}
#define OPS_FUN_PREFIX __device__ __host__
#include "user_types.h"
{% endif %}
{% endblock %}

{% block const_decls %}
//  global constants
    {% for const in app.consts() %}
    {% if const.dim.isdigit() %}
        {% set NDIM = const.dim|int %}
            {% if NDIM > 1 %}
__constant__ {{const_c_type[loop.index0]}} {{const.ptr}}[{{NDIM}}];
            {% else %}
__constant__ {{const_c_type[loop.index0]}} {{const.ptr}};
            {% endif %}
    {% else %}
__constant__ {{const_c_type[loop.index0]}} *{{const.ptr}};
    {% endif %}
    {% endfor %}

{% if jit %}
extern "C" void ops_jit_init(void);
void ops_init_backend(){ ops_jit_init(); }
{% else %}
void ops_init_backend(){}
{% endif %}

{% if jit %}
#include <cctype>
#include <cstring>

// The JIT reads constants from OPS's registry, under their Fortran (lower case) names.
static void ops_jit_register_const_f2c(char const *name, int dim, char const *type, int size, char *dat) {
    char lname[256];
    size_t n = strlen(name) < sizeof(lname) - 1 ? strlen(name) : sizeof(lname) - 1;
    for (size_t i = 0; i < n; i++) lname[i] = (char)tolower((unsigned char)name[i]);
    lname[n] = '\0';
    ops_register_const_char(OPS_instance::getOPSInstance(), dim, type, size, dat, lname);
}

{% endif %}
extern "C"
void ops_decl_const_f2c(char const *name, int dim, int size, char *dat) {

    OPS_instance *instance = OPS_instance::getOPSInstance();
    ops_execute(instance);

    {% for const in app.consts() %}
    if(!strcmp(name, "{{const.name}}")) {
{% if jit %}
        ops_jit_register_const_f2c(name, dim, "{{const_c_type[loop.index0]}}", size, dat);
{% endif %}
        {% if const.dim.isdigit() %}
            {% if target.name == "f2c_cuda" %}
        cutilSafeCall(instance->ostream(), cudaMemcpyToSymbol({{const.ptr}}, dat, dim*size));
            {% elif target.name == "f2c_hip" %}
        hipSafeCall(instance->ostream(), hipMemcpyToSymbol(HIP_SYMBOL({{const.ptr}}), dat, dim*size));
            {% endif %}
        {% else %}
            {% if target.name == "f2c_cuda" %}
        char *temp; cutilSafeCall(instance->ostream(), cudaMalloc((void**)&temp, dim*size));
        cutilSafeCall(instance->ostream(), cudaMemcpy(temp, dat, dim*size, cudaMemcpyHostToDevice));
        cutilSafeCall(instance->ostream(), cudaMemcpyToSymbol({{const.ptr}}, &temp, sizeof(char *)));
            {% elif target.name == "f2c_hip" %}
        char *temp; hipSafeCall(instance->ostream(), hipMalloc((void**)&temp, dim*size));
        hipSafeCall(instance->ostream(), hipMemcpy(temp, dat, dim*size, hipMemcpyHostToDevice));
        hipSafeCall(instance->ostream(), hipMemcpyToSymbol(HIP_SYMBOL({{const.ptr}}), &temp, sizeof(char *)));
            {% endif %}
        {% endif %}
    } 
    else
    {% if loop.last %}
    {
        throw OPSException(OPS_RUNTIME_ERROR, "error: unknown const name");
    }
    {% endif %}
    {% endfor %}
}
{% endblock %}

{% block header_includes %}
{{super()}}
{% endblock %}
